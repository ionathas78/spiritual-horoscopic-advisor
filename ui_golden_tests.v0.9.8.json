          "render_behavior": {
            "include_images": true
          }
        },
        "expected_shape": {
          "sections_in_order": [
            "image_entity",
            "devotional_title_optional",
            "quote_block",
            "devotional_paragraphs_matching_selected_profile",
            "scripture_reference_link_only",
            "additional_references_optional"
          ],
          "image_group": {
            "required": true,
            "renderer": "image_group",
            "markdown_images_forbidden": true
          },
          "quote_block": {
            "required": true,
            "quote_text_unlinked": true,
            "attribution_line_contains_single_link": true
          },
          "scripture": {
            "position": "bottom",
            "expanded_text_present": false,
            "reference_is_hyperlinked_markdown": true
          }
        }
      },
      {
        "id": "golden_reversi_order_reference_devotional_quote",
