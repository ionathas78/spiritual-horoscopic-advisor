{
  "ui_golden_render_tests": {
    "id": "ui_golden_render_tests.v0.9.8",
    "purpose": "Menubar-level UI consistency checks for devotional renders. Snapshot-style shape verification; wording may vary but structural invariants must hold.",
    "run_when": "post_render_pre_publish",
    "fail_closed": false,
    "notes": [
      "These are shape tests: ordering, hyperlink placement, image entity placement, and conditional scripture expansion rules.",
      "They are designed to catch 'looks wrong' regressions before publish.",
      "They do not validate theology or content quality; lint + editor + focus group handle that.",
      "Image selection should prefer one strong distinct image over multiple near-duplicates when rendering allows variation.",
      "When multiple visual metaphors appear, the image should follow the highest-weight metaphor rather than the first decorative noun.",
      "Render-only failure must degrade cleanly rather than withholding output.",
      "Pre-render surface lock must prepare fallback material before final render attempts.",
      "Fallback repair is slot-based: it may replace invalid section contents, but may not move sections out of their selected layout positions.",
      "Footer footnotes are permitted after the scripture reference only when needed to attribute direct quotations in the devotional body.",
      "Any scripture citation appearing in footer footnotes must use the same bracketed hyperlink style as the reference section.",
      "Primary scripture may be studied with a broader internal range, but no overlapping expansion may appear as a second surface citation or quote.",
      "Optional plain-text titles may appear after the image and before the first primary surface.",
      "Additional References is the sole permitted metadata heading and appears only for a nonempty influential-source block.",
      "Footer order is primary terminal surface, optional Additional References, then optional quotation footnotes.",
      "Additional References must contain at least one, preferably two, materially influential supporting Scripture references before patristic or other non-scriptural sources."
    ],
    "fixtures": [
      {
        "id": "golden_default_order_quote_devotional_reference",
        "prefs": {
          "formatting": {
            "output_ordering": "quote_devotional_reference"
